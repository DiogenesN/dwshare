#!/bin/bash

# App Name: dwshare
# Description: Simple GUI file sharing over a local network.
#              PC -> phone: browse/download files from current directory.
#              Phone -> PC: upload files directly to ~/Downloads.
# Dependencies: yad, python3, coreutils, grep, ufw (optional), dwexec (optional)


# ============================================================
# Function to stop the server
# ============================================================

stop_server() {
	if [ -n "$SERVER_PID" ]; then
		kill "$SERVER_PID" 2>/dev/null
		wait "$SERVER_PID" 2>/dev/null
		SERVER_PID=""
	fi

	# Backup cleanup using port 8000
	fuser -k 8000/tcp 2>/dev/null
}


# ============================================================
# Ensure server stops if script is closed unexpectedly
# ============================================================

trap stop_server EXIT


# ============================================================
# Start server
# ============================================================

run_server() {

	# Create temporary Python server only when Connect is pressed
	PYTHON_SERVER=$(mktemp)

	cat > "$PYTHON_SERVER" <<'PYTHON'
#!/usr/bin/env python3

import os
import html
import urllib.parse
from http.server import HTTPServer, BaseHTTPRequestHandler

PORT = 8000

# PC directory that will be browsable/downloadable
SHARE_DIR = os.getcwd()

# Phone uploads go here
UPLOAD_DIR = os.path.expanduser("~/Downloads")


class DWShareHandler(BaseHTTPRequestHandler):

	def send_html(self, page, status=200):
		data = page.encode("utf-8")

		self.send_response(status)
		self.send_header("Content-Type", "text/html; charset=utf-8")
		self.send_header("Content-Length", str(len(data)))
		self.end_headers()

		self.wfile.write(data)


	def do_GET(self):

		path = urllib.parse.unquote(
			self.path.split("?", 1)[0]
		)

		if path == "/":
			self.show_directory(SHARE_DIR, "/")
			return

		filepath = os.path.abspath(
			os.path.join(SHARE_DIR, path.lstrip("/"))
		)

		share_root = os.path.abspath(SHARE_DIR)

		# Prevent accessing files outside the shared directory
		if not (
			filepath == share_root
			or filepath.startswith(share_root + os.sep)
		):
			self.send_error(403, "Forbidden")
			return

		if os.path.isdir(filepath):
			self.show_directory(filepath, path)
			return

		if os.path.isfile(filepath):

			try:
				size = os.path.getsize(filepath)

				self.send_response(200)
				self.send_header(
					"Content-Type",
					"application/octet-stream"
				)
				filename = os.path.basename(filepath)
				encoded_filename = urllib.parse.quote(filename)
				self.send_header(
					"Content-Disposition",
					f"attachment; filename*=UTF-8''{encoded_filename}"
				)
				self.send_header(
					"Content-Length",
					str(size)
				)
				self.end_headers()

				with open(filepath, "rb") as f:
					while True:
						data = f.read(1024 * 1024)

						if not data:
							break

						self.wfile.write(data)

			except Exception as e:
				self.send_error(500, str(e))

			return

		self.send_error(404, "Not found")


	def show_directory(self, directory, url_path):

		try:
			entries = sorted(
				os.listdir(directory),
				key=lambda name: (
					not os.path.isdir(
						os.path.join(directory, name)
					),
					name.lower()
				)
			)

		except PermissionError:
			self.send_error(403, "Permission denied")
			return

		rows = []

		if url_path != "/":
			parent = os.path.dirname(
				url_path.rstrip("/")
			) or "/"

			rows.append(
				'<li><a href="{}">📁 ..</a></li>'.format(
					urllib.parse.quote(
						parent,
						safe="/"
					)
				)
			)

		for name in entries:

			fullpath = os.path.join(
				directory,
				name
			)

			encoded = urllib.parse.quote(name)

			if os.path.isdir(fullpath):

				rows.append(
					'<li>📁 '
					'<a href="{}{}/">{}/</a>'
					'</li>'.format(
						url_path,
						encoded,
						html.escape(name)
					)
				)

			else:

				rows.append(
					'<li>📄 '
					'<a href="{}{}">{}</a>'
					'</li>'.format(
						url_path,
						encoded,
						html.escape(name)
					)
				)

		page = """<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>dwshare</title>

<style>
body {{
	font-family: sans-serif;
	margin: 20px;
	font-size: 18px;
}}

h1 {{
	font-size: 28px;
}}

.upload {{
	margin: 20px 0;
	padding: 15px;
	border: 1px solid #aaa;
	border-radius: 8px;
}}

input[type=file] {{
	width: 100%;
	margin-bottom: 12px;
	font-size: 16px;
}}

input[type=submit] {{
	font-size: 18px;
	padding: 10px 20px;
}}

li {{
	margin: 10px 0;
	word-break: break-word;
}}

a {{
	text-decoration: none;
}}

.note {{
	font-size: 14px;
	opacity: 0.7;
	margin-top: 8px;
}}
</style>

</head>

<body>

<h1>dwshare</h1>

<div class="upload">

<strong>Upload files to PC</strong>

<br><br>

<form method="POST" enctype="multipart/form-data">

<input type="file" name="files" multiple>

<br>

<input type="submit" value="Upload">

</form>

<div class="note">
Uploaded files are saved to ~/Downloads
</div>

</div>

<h2>Files on PC</h2>

<ul>
{rows}
</ul>

</body>
</html>
""".format(
			rows="".join(rows)
		)

		self.send_html(page)


	def do_POST(self):

		content_type = self.headers.get(
			"Content-Type",
			""
		)

		if not content_type.startswith(
			"multipart/form-data"
		):
			self.send_error(
				400,
				"Multipart upload required"
			)
			return

		try:
			boundary = content_type.split(
				"boundary=",
				1
			)[1]

		except IndexError:
			self.send_error(
				400,
				"Missing boundary"
			)
			return

		boundary = boundary.strip('"').encode()

		try:
			length = int(
				self.headers.get(
					"Content-Length",
					"0"
				)
			)

		except ValueError:
			self.send_error(
				400,
				"Invalid Content-Length"
			)
			return

		body = self.rfile.read(length)

		uploaded = []

		for part in body.split(
			b"--" + boundary
		):

			if b'filename="' not in part:
				continue

			header_end = part.find(
				b"\r\n\r\n"
			)

			if header_end == -1:
				continue

			headers = part[
				:header_end
			].decode(
				"utf-8",
				errors="replace"
			)

			data = part[
				header_end + 4:
			]

			if data.endswith(b"\r\n"):
				data = data[:-2]

			start = headers.find(
				'filename="'
			)

			if start == -1:
				continue

			start += len('filename="')

			end = headers.find(
				'"',
				start
			)

			if end == -1:
				continue

			filename = headers[
				start:end
			]

			# Strip any path Android/browser might send
			filename = os.path.basename(filename)

			if not filename:
				continue

			filename = filename.replace(
				"\x00",
				""
			)

			os.makedirs(
				UPLOAD_DIR,
				exist_ok=True
			)

			destination = os.path.join(
				UPLOAD_DIR,
				filename
			)

			# Write directly to ~/Downloads
			with open(
				destination,
				"wb"
			) as f:
				f.write(data)

			uploaded.append(filename)

		if uploaded:

			items = "".join(
				"<li>{}</li>".format(
					html.escape(name)
				)
				for name in uploaded
			)

			message = """
<h2>Upload complete</h2>

<p>Uploaded:</p>

<ul>
{}
</ul>

<p>
Saved to <strong>~/Downloads</strong>
</p>

<p>
<a href="/">← Back to files</a>
</p>
""".format(items)

		else:

			message = """
<h2>No files uploaded</h2>

<p>
<a href="/">← Back to files</a>
</p>
"""

		self.send_html("""
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>dwshare</title>
</head>

<body>

{}

</body>
</html>
""".format(message))


	def log_message(self, format, *args):
		# Keep terminal quiet
		pass


server = HTTPServer(
	("0.0.0.0", PORT),
	DWShareHandler
)

try:
	server.serve_forever()

except KeyboardInterrupt:
	pass

finally:
	server.server_close()

PYTHON

	chmod +x "$PYTHON_SERVER"


	# Start Python server
	python3 "$PYTHON_SERVER" &
	SERVER_PID=$!

	sleep 1


	# Get local IP (first one listed)
	IP_ADDR=$(hostname -I | awk '{print $1}')


	yad --title="Connection Active - dwshare" \
		--window-icon="network-workgroup" \
		--info \
		--center \
		--text-align=center \
		--buttons-layout=center \
		--width=400 \
		--text="<span font='12'>On your other device (phone, tablet) open the browser and enter the following address:</span>\n\n<span font='18' weight='bold'>http://$IP_ADDR:8000</span>" \
		--button="Close connection:0"


	# Stop server
	stop_server


	# Remove temporary Python file
	rm -f "$PYTHON_SERVER"
	PYTHON_SERVER=""
}


# ============================================================
# Disable firewall
# ============================================================

disable_firewall() {

	if command -v dwexec >/dev/null 2>&1; then

		if [ -f "/usr/sbin/ufw" ]; then

			dwexec /usr/sbin/ufw disable

			if [ $? -eq 0 ]; then
				run_server
			else
				yad \
					--error \
					--center \
					--text-align=center \
					--buttons-layout=center \
					--text="Failed to disable UFW via dwexec."
			fi

		else

			yad \
				--center \
				--text-align=center \
				--buttons-layout=center \
				--info \
				--text="Could not disable the firewall 1, you need to manually disable the firewall (UFW not found)."

		fi

	else

		yad \
			--center \
			--text-align=center \
			--buttons-layout=center \
			--info \
			--text="Could not disable the firewall 2, you need to manually disable the firewall (dwexec not found)."

	fi
}


# ============================================================
# Re-enable firewall
# ============================================================

enable_firewall() {

	if command -v dwexec >/dev/null 2>&1 &&
		[ -f "/usr/sbin/ufw" ]; then

		dwexec /usr/sbin/ufw enable

		yad \
			--center \
			--text-align=center \
			--buttons-layout=center \
			--info \
			--text="Firewall re-enabled." \
			--timeout=2

	else

		yad \
			--center \
			--text-align=center \
			--text-align=center \
			--buttons-layout=center \
			--error \
			--text="dwexec or ufw not found. Cannot re-enable."

	fi
}


# ============================================================
# Main Loop
# ============================================================

while true; do

	ACTION=$(yad \
		--title="dwshare" \
		--window-icon="network-transmit-receive" \
		--width=500 \
		--center \
		--text-align=center \
		--buttons-layout=center \
		--text="If you do not have any firewall installed on your system or it is disabled then click on 'Connect', if not sure then click 'Disable firewall'." \
		--button="Connect":1 \
		--button="Disable firewall":2 \
		--button="Re-enable firewall":3 \
		--button="Close":4)


	RET=$?


	case $RET in

		1)
			run_server
			;;

		2)
			disable_firewall
			;;

		3)
			enable_firewall
			;;

		*)
			exit 0
			;;

	esac

done
